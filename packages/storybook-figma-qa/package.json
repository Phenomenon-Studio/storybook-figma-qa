{
    "name": "@phenomenon-studio/storybook-figma-qa",
    "version": "0.0.0",
    "description": "Figma QA kit: checks Storybook stories against the Figma UI kit (Storybook addon, Vitest plugin, figma-qa CLI, agent skills).",
    "type": "module",
    "license": "UNLICENSED",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Phenomenon-Studio/storybook-figma-qa.git",
        "directory": "packages/storybook-figma-qa"
    },
    "exports": {
        "./preset": {
            "types": "./dist/preset.d.ts",
            "default": "./dist/preset.js"
        },
        "./manager": {
            "types": "./dist/manager.d.ts",
            "default": "./dist/manager.js"
        },
        "./preview": {
            "types": "./dist/preview.d.ts",
            "default": "./dist/preview.js"
        },
        "./config": {
            "types": "./dist/config.d.ts",
            "default": "./dist/config.js"
        },
        "./vitest": {
            "types": "./dist/vitest.d.ts",
            "default": "./dist/vitest.js"
        },
        "./package.json": "./package.json"
    },
    "bin": {
        "figma-qa": "./dist/cli.js"
    },
    "files": [
        "dist",
        "skills"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "pixelmatch": "8.0.0",
        "pngjs": "7.0.0",
        "tinyglobby": "0.2.17"
    },
    "peerDependencies": {
        "@storybook/addon-vitest": "^10.6.0 || ^11.0.0-0",
        "@vitest/browser-playwright": "^4.0.0 || ^5.0.0",
        "react": "^18.0.0 || ^19.0.0",
        "storybook": "^10.6.0 || ^11.0.0-0",
        "vite": ">=6.3.0",
        "vitest": "^4.0.0 || ^5.0.0"
    },
    "devDependencies": {
        "@storybook/addon-vitest": "10.6.8",
        "@types/node": "22.20.5",
        "@types/pngjs": "6.0.5",
        "@types/react": "19.3.0",
        "@vitest/browser": "4.1.12",
        "@vitest/browser-playwright": "4.1.12",
        "playwright": "1.65.1",
        "react": "19.3.1",
        "storybook": "10.6.8",
        "typescript": "6.0.3",
        "vite": "8.3.8",
        "vitest": "4.1.12"
    },
    "engines": {
        "node": ">=22.12"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    }
}
